+/// Does @p nfa have a transition on @c EPSILON? EPSILON is the largest symbol,
+/// so one symbol post per state is read.
+bool contains_epsilon(const Nfa &nfa) {
+  const size_t num_of_states{nfa.num_of_states()};
+  for (State state{0}; state < num_of_states; ++state) {
+    const StatePost &state_post{nfa.delta[state]};
+    if (Delta::epsilon_symbol_posts(state_post) != state_post.end()) {
+      return true;
+    }
+  }
+  return false;
 }
