+bool mata::nfa::algorithms::is_universal_antichains(const Nfa &aut,
+                                                    const Alphabet &alphabet,
+                                                    Run *cex) {
+  // The language of @p aut is universal iff it includes Σ*, accepted by one
+  // initial and final state looping on
+  //  every letter.
+  Nfa sigma_star{1, {0}, {0}};
+  for (const Symbol symbol : alphabet.get_alphabet_symbols()) {
+    sigma_star.delta.add(0, symbol, 0);
+  }
+  const bool universal{is_included_antichains(sigma_star, aut, &alphabet, cex)};
+  // The run goes through the only state of `sigma_star`, which says nothing
+  // about @p aut.
+  if (cex != nullptr) {
+    cex->path.clear();
+  }
+  return universal;
+}
 
