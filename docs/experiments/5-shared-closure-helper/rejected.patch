+/** @file
+ * @brief Strongly connected components over the transitions selected by a predicate, shared by the NFA epsilon
+ *  removal and the NFT projection; not installed.
+ */
+
+#ifndef MATA_SRC_NFA_EDGE_COMPONENTS_HH_
+#define MATA_SRC_NFA_EDGE_COMPONENTS_HH_
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <span>
+#include <vector>
+
+#include "mata/nfa/delta.hh"
+#include "mata/nfa/types.hh"
+
+namespace mata::nfa::internal {
+
+/**
+ * @brief Strongly connected components of the graph whose edges are the transitions selected by the caller, found by
+ *  an iterative Tarjan's algorithm from the roots the caller visits.
+ *
+ * A component is numbered when Tarjan's algorithm finishes it, so every component reachable from a component has a
+ *  smaller number, and a closure over the selected edges can be composed bottom-up in number order. The edges are
+ *  walked as given: no order of the states (such as the NFT levels, which wrap around through level 0) is assumed.
+ */
+class EdgeComponents {
+  public:
+	/// Component of a state that is not in one.
+	static constexpr uint32_t NO_COMPONENT = std::numeric_limits<uint32_t>::max();
+
+	/// Components over the states 0, ..., @p num_of_states - 1.
+	explicit EdgeComponents(const size_t num_of_states)
+		: component_of_(num_of_states, NO_COMPONENT), index_(num_of_states, UNVISITED), low_(num_of_states, 0) {}
+
+	/**
+	 * @brief Finds the components of the states reachable from @p root that are not in a component yet.
+	 *
+	 * The edges out of a state @c s are the targets @c t of the symbol posts @c selected_posts(s) with
+	 *  @c is_edge(s, t). @c is_edge must reject every target outside the states.
+	 *
+	 * @param selected_posts Callable @c (State) -> std::span<const SymbolPost>.
+	 * @param is_edge Callable @c (State source, State target) -> bool.
+	 */
+	template <class SelectedPosts, class IsEdge>
+	void visit(const State root, SelectedPosts&& selected_posts, IsEdge&& is_edge) {
+		if (index_[root] != UNVISITED) { return; }
+		enter(root, selected_posts(root));
+
+		while (!frames_.empty()) {
+			Frame& frame = frames_.back();
+			if (frame.post < frame.posts.size()) {
+				const auto& targets = frame.posts[frame.post].targets;
+				if (frame.target == targets.size()) {
+					++frame.post;
+					frame.target = 0;
+					continue;
+				}
+				const State target = targets[frame.target];
+				++frame.target;
+				if (!is_edge(frame.state, target)) { continue; }
+				if (index_[target] == UNVISITED) {
+					enter(target, selected_posts(target));
+				} else if (component_of_[target] == NO_COMPONENT) {
+					low_[frame.state] = std::min(low_[frame.state], index_[target]);
+				}
+				continue;
+			}
+
+			const State state = frame.state;
+			frames_.pop_back();
+
+			if (!frames_.empty()) { low_[frames_.back().state] = std::min(low_[frames_.back().state], low_[state]); }
+			if (low_[state] != index_[state]) { continue; }
+
+			const auto component = static_cast<uint32_t>(ends_.size());
+			State member;
+			do {
+				member = stack_.back();
+				stack_.pop_back();
+				component_of_[member] = component;
+				members_.push_back(member);
+			} while (member != state);
+			ends_.push_back(members_.size());
+		}
+	}
+
+	/// Number of components found so far.
+	size_t size() const { return ends_.size(); }
+
+	/// Component of @p state, or @c NO_COMPONENT if no visit has reached it.
+	uint32_t component_of(const State state) const { return component_of_[state]; }
+
+	/// The states of @p component.
+	std::span<const State> members_of(const size_t component) const {
+		const size_t begin = component == 0 ? 0 : ends_[component - 1];
+		return {members_.data() + begin, ends_[component] - begin};
+	}
+
+  private:
+	static constexpr uint32_t UNVISITED = std::numeric_limits<uint32_t>::max();
+
+	struct Frame {
+		State state;
+		std::span<const SymbolPost> posts;
+		size_t post;
+		size_t target;
+	};
+
+	std::vector<State> members_{}; ///< States grouped by component.
+	std::vector<size_t> ends_{}; ///< End of each component in @c members_.
+	std::vector<uint32_t> component_of_;
+	std::vector<uint32_t> index_;
+	std::vector<uint32_t> low_;
+	std::vector<State> stack_{};
+	std::vector<Frame> frames_{};
+	uint32_t next_index_{0};
+
+	void enter(const State state, const std::span<const SymbolPost> posts) {
+		index_[state] = next_index_;
+		low_[state] = next_index_;
+		++next_index_;
+		stack_.push_back(state);
+		frames_.push_back({.state = state, .posts = posts, .post = 0, .target = 0});
+	}
+};
+
+} // namespace mata::nfa::internal
+
+#endif // MATA_SRC_NFA_EDGE_COMPONENTS_HH_
