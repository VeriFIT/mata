diff --git a/scripts/tools/cudd.sh b/scripts/tools/cudd.sh
new file mode 100644
index 00000000..1ac5dd68
--- /dev/null
+++ b/scripts/tools/cudd.sh
@@ -0,0 +1,31 @@
+# cudd: the harness' C++ interpreter on symbolic NFAs whose transitions are
+# labelled by BDDs of CUDD (the textbook algorithms over the guards: product,
+# subset construction splitting the guards, antichain inclusion). Reads
+# '@NFA-bits' inputs only, with the harness' own reader. A revision is a CUDD
+# release, e.g. 3.0.0, from the GitHub mirror of the releases.
+#
+# CUDD is built with its own optimisation flags (-O3) whatever the build mode;
+# the binary links libcudd statically.
+
+subject="tarball:https://github.com/ivmai/cudd/archive/refs/tags/cudd-{rev}.tar.gz"
+runs="emp"
+
+build() {
+    local build="$outdir/cudd-build" prefix="$outdir/prefix"
+    local harness_build="$outdir/harness-build"
+
+    rm -rf "$build" "$prefix"
+    mkdir -p "$build"
+    (cd "$build" && "$worktree/configure" --prefix="$prefix" --disable-shared >/dev/null)
+    make -C "$build" --jobs="$jobs" >/dev/null
+    make -C "$build" install >/dev/null
+
+    echo "======== Building the C++ interpreter ========"
+    cmake -B "$harness_build" -S "$harness" \
+        -DCMAKE_BUILD_TYPE=Release \
+        -DCMAKE_PREFIX_PATH="$prefix" \
+        -DMATA_INTERPRETERS:BOOL=OFF \
+        -DCUDD_INTERPRETER:BOOL=ON
+    cmake --build "$harness_build" --parallel "$jobs" --target cudd-emp-interpreter
+    cp "$harness_build/src/cpp/cudd-emp-interpreter" "$binary"
+}
diff --git a/scripts/tools/mata-bdd.sh b/scripts/tools/mata-bdd.sh
new file mode 100644
index 00000000..1f099210
--- /dev/null
+++ b/scripts/tools/mata-bdd.sh
@@ -0,0 +1,27 @@
+# mata-bdd: the harness' C++ interpreter on mata's NFTs used as automata with
+# BDDs on their transitions (one NFT level per variable of the bitvector),
+# linked against libmata of the revision. Reads '@NFA-bits' inputs only, with
+# the harness' own reader: it must not mintermize.
+
+subject=subjects/mata
+runs="emp"
+
+build() {
+    local build="$outdir/mata-build" prefix="$outdir/prefix"
+    local harness_build="$outdir/harness-build"
+
+    cmake -B "$build" -S "$worktree" \
+        -DCMAKE_BUILD_TYPE="$build_mode" \
+        -DCMAKE_INSTALL_PREFIX="$prefix" \
+        -DBUILD_TESTING:BOOL=OFF \
+        -DMATA_BUILD_EXAMPLES:BOOL=OFF
+    cmake --build "$build" --parallel "$jobs" --target libmata
+    cmake --install "$build" >/dev/null
+
+    echo "======== Building the C++ interpreter ========"
+    cmake -B "$harness_build" -S "$harness" \
+        -DCMAKE_BUILD_TYPE=Release \
+        -DCMAKE_PREFIX_PATH="$prefix"
+    cmake --build "$harness_build" --parallel "$jobs" --target mata-bdd-emp-interpreter
+    cp "$harness_build/src/cpp/mata-bdd-emp-interpreter" "$binary"
+}
diff --git a/scripts/tools/mona.sh b/scripts/tools/mona.sh
new file mode 100644
index 00000000..f3211b87
--- /dev/null
+++ b/scripts/tools/mona.sh
@@ -0,0 +1,34 @@
+# mona: the harness' C++ interpreter on MONA's DFA library, whose automata have
+# a shared multi-terminal BDD per state. MONA has DFAs only: an NFA is
+# determinized when it is loaded, by projecting out choice variables as MONA
+# quantifies (see interpreter_mona.cc). Reads '@NFA-bits' inputs only, with the
+# harness' own reader. A revision is a tag or a commit of
+# https://github.com/cs-au-dk/MONA, e.g. 1.4-18.
+#
+# Only MONA's libraries (Mem, BDD, DFA) are built, with MONA's own optimisation
+# flags (-O3) whatever the build mode; its configure needs flex and bison all
+# the same. The binary links them statically.
+
+subject="tarball:https://github.com/cs-au-dk/MONA/archive/{rev}.tar.gz"
+runs="emp"
+
+build() {
+    local prefix="$outdir/prefix" harness_build="$outdir/harness-build" dir
+
+    # In the source tree: DFA's makefile finds BDD's headers there only. The
+    # tarball is unpacked afresh for every build.
+    rm -rf "$prefix"
+    (cd "$worktree" && ./configure --prefix="$prefix" --disable-shared >/dev/null)
+    for dir in Mem BDD DFA; do
+        make -C "$worktree/$dir" --jobs="$jobs" install >/dev/null
+    done
+
+    echo "======== Building the C++ interpreter ========"
+    cmake -B "$harness_build" -S "$harness" \
+        -DCMAKE_BUILD_TYPE=Release \
+        -DCMAKE_PREFIX_PATH="$prefix" \
+        -DMATA_INTERPRETERS:BOOL=OFF \
+        -DMONA_INTERPRETER:BOOL=ON
+    cmake --build "$harness_build" --parallel "$jobs" --target mona-emp-interpreter
+    cp "$harness_build/src/cpp/mona-emp-interpreter" "$binary"
+}
diff --git a/suites/bdd.toml b/suites/bdd.toml
new file mode 100644
index 00000000..8d3f0f04
--- /dev/null
+++ b/suites/bdd.toml
@@ -0,0 +1,34 @@
+# Automata with BDDs on their transitions: mata's NFTs used as such automata
+# (mata-bdd: one NFT level per variable of the bitvector) against libraries
+# built on BDDs, on the experiments of the TACAS'24 suite whose inputs have
+# bitvector alphabets. cudd (symbolic NFAs over CUDD's BDDs) is the baseline of
+# the report; mona (MONA's DFA library) determinizes every input when loading
+# it; mata is mata's own way, mintermizing the inputs into explicit NFAs.
+# Compare the operations, not the runtime: the 'operation' column sums the
+# operations of the program, without the parsing and the construction of the
+# automata (columns 'parsing'/'mataparsing', 'construction', 'mataminterm').
+#
+#   scripts/bench.py suites/bdd.toml --fetch-from ../mata --repeat 3
+#   scripts/bench.py suites/bdd.toml --only lia-symbolic mata-bdd:v1.32.45-dev.57,devel cudd:3.0.0
+
+include = [
+  { path = "tacas-24.toml", only = [
+    "armc-incl",
+    "b-smt",
+    "email-filter",
+    "lia-symbolic",
+    "param-inter",
+    "param-inter-variadic",
+    "param-union",
+    "param-union-variadic",
+    "param-diff",
+  ] },
+]
+
+[defaults]
+timeout = 60
+# A determinization that blows up (mona's loading, complements) fails the run
+# as a memout rather than taking the machine down.
+memout = 8
+metrics = ["operation", "runtime"]
+builds = ["cudd:3.0.0", "mata-bdd:devel", "mona:1.4-18", "mata:devel"]
-- 
