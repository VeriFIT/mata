+                 std::unordered_map<std::pair<State, State>, State> *prod_map = nullptr, JumpMode jump_mode = JumpMode::RepeatSymbol,
+                 State lhs_first_aux_state = Limits::max_state, State rhs_first_aux_state = Limits::max_state);
+
+/**
