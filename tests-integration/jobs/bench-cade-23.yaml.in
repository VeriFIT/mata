# Mata engines return 0 on success and a nonzero code only on failure; anything
# else is an error, refined into a crash or a memout by pycobench itself.
# The `b-*-matasc` jobs run the Mata Script versions of the `b-armc-incl` and
# `b-regex` benchmarks through the `mata` command, which pycobench finds through
# `@MATA_CLI_CMD@`; see `nix/mata-cli.nix` and `scripts/*.matasc`.
defaults:
  return_codes:
    0: finished
    "*": error

b-armc-incl:
    cmd: @CMAKE_CURRENT_BINARY_DIR@/bench-automata-inclusion $1 $2

b-armc-incl-matasc:
    cmd: @MATA_CLI_CMD@ script run @CMAKE_CURRENT_SOURCE_DIR@/scripts/automata-inclusion.matasc $1 $2

b-regex:
    cmd: @CMAKE_CURRENT_BINARY_DIR@/bench-email-filter $1 $2 $3 $4 $5

b-regex-matasc:
    cmd: @MATA_CLI_CMD@ script run @CMAKE_CURRENT_SOURCE_DIR@/scripts/email-filter.matasc $1 $2 $3 $4 $5

b-param-diff:
    cmd: @CMAKE_CURRENT_BINARY_DIR@/bench-bool-comb-cox-diff $1 $2

b-param-inter:
    cmd: @CMAKE_CURRENT_BINARY_DIR@/bench-bool-comb-cox-inter $1 $2

b-param-intersect:
    cmd: @CMAKE_CURRENT_BINARY_DIR@/bench-bool-comb-intersect $1
