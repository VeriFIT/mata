# Mata engines return 0 on success and a nonzero code only on failure; anything
# else is an error, refined into a crash or a memout by pycobench itself.
defaults:
  return_codes:
    0: finished
    "*": error

nfa:
  cmd: @CMAKE_CURRENT_BINARY_DIR@/nfa-operations $1

unary:
  cmd: @CMAKE_CURRENT_BINARY_DIR@/unary-operations $1