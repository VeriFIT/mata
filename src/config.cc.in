 /* config.cc -- definition of global symbols used in library
 *
 * Expanded into '<build>/src/config.cc' by 'cmake/GetGitSha.cmake', which runs as a build step of
 * libmata and rewrites the file only when the git hash changes.
 */

#include "mata/utils/utils.hh"

unsigned mata::LOG_VERBOSITY = 0;

#define GIT_SHA1 "@GIT_SHA1@"
const std::string mata::g_GIT_SHA1 = GIT_SHA1;
