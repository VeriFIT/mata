digraph "Alphabet"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="Alphabet",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="The abstract interface for NFA alphabets."];
  Node1 -> Node2 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="EnumAlphabet",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classmata_1_1EnumAlphabet.html",tooltip="Enumerated alphabet using a set of integers as symbols maintaining a set of specified symbols."];
  Node1 -> Node3 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="IntAlphabet",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classmata_1_1IntAlphabet.html",tooltip="Direct alphabet (also identity alphabet or integer alphabet) using integers as symbols."];
  Node1 -> Node4 [id="edge3_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="OnTheFlyAlphabet",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classmata_1_1OnTheFlyAlphabet.html",tooltip="An alphabet constructed 'on the fly'."];
}
